    "exceljs": "4.4.0",
    "fastify": "^5.12.7",
    "papaparse": "5.5.3",
    "postgres": "3.4.9",
    "tsx": "4.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/papaparse": "^5.3.16",
    "@types/ws": "^8.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
